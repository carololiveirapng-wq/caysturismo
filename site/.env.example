# Copie este arquivo para `.env.local` e preencha o que já existir. Nenhuma
# credencial real deve entrar neste arquivo (.env.example) nem em .env.local
# neste ambiente — apenas os nomes das variáveis. Na Vercel, o equivalente é
# a aba Settings → Environment Variables do projeto (ver seção "Passo a
# passo" na entrega deste round para o caminho exato).

# =============================================================================
# PUBLIC — prefixo NEXT_PUBLIC_, embutidas no bundle client. Não são
# segredo, mas também não deveriam guardar nada sensível.
# =============================================================================

# Domínio real do site. Em desenvolvimento pode ficar vazio (cai em
# http://localhost:3000 automaticamente). Em produção, defina como o domínio
# *.vercel.app até o domínio oficial estar pronto, depois troque.
# Usado em: canonical, Open Graph, JSON-LD, metadataBase.
NEXT_PUBLIC_SITE_URL=

# Projeto/dataset do Sanity. Sem NEXT_PUBLIC_SANITY_PROJECT_ID, o site
# inteiro funciona normalmente com os dados mockados em src/data/ — nada
# quebra, só fica sem o CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Com o Sanity configurado (acima), uma entidade publicada que não existe
# lá vira notFound() — não cai mais silenciosamente pro mock, pra não
# mascarar um erro editorial real em produção. Ligue "true" apenas em
# homologação/dev pra continuar testando páginas localmente sem precisar
# popular tudo no Studio primeiro. Sem NEXT_PUBLIC_SANITY_PROJECT_ID, o
# fallback pro mock já acontece sempre, independente desta flag.
NEXT_PUBLIC_CMS_MOCK_FALLBACK=

# =============================================================================
# PRIVATE — sem prefixo NEXT_PUBLIC_, só existem no servidor. Nunca expor
# no client; nunca commitar valor real.
# =============================================================================

# Banco de dados (leads). Sem isto: em desenvolvimento, o formulário grava
# num arquivo local (.data/leads.dev.ndjson, nunca commitado — não é banco
# de verdade); em produção, o envio falha com erro explícito em vez de
# fingir que salvou (ver src/lib/leads/repository.ts). Funciona com
# qualquer Postgres compatível (Neon, Supabase, Railway, RDS...), não só
# Vercel Postgres — inclua ?sslmode=require se o provedor exigir.
DATABASE_URL=

# Notificação de novo lead por e-mail (Resend). Sem as três, o lead ainda é
# salvo normalmente — só a notificação por e-mail não sai (ver
# src/lib/leads/notify.ts). O domínio usado em LEAD_NOTIFICATION_FROM
# precisa estar verificado em resend.com/domains antes do primeiro envio.
# Formato: "Nome <endereco@seu-dominio-verificado.com.br>"
# Exemplo:  LEAD_NOTIFICATION_FROM=Cays Turismo <leads@caysturismo.com.br>
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_FROM=

# Token de LEITURA do Sanity — só necessário se o dataset não for público
# ou se quiser buscar conteúdo em rascunho (preview). Nunca usar o token de
# escrita aqui. Nunca prefixar com NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Secret do webhook de revalidation (ver src/app/api/revalidate/route.ts).
# Gere uma string aleatória longa (ex.: openssl rand -hex 32) e use o mesmo
# valor na URL do webhook configurado em sanity.io/manage. Sem isto, o
# endpoint de revalidation recusa qualquer request.
SANITY_REVALIDATE_SECRET=
